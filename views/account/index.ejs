<% if (title) { %>
  <h1><%= title %></h1>
<% } else { res.redirect('/') } %>

<%- messages() %>

<% if (errors) { %>
  <br />  
  <ul class="notice">
    <% errors.array().forEach(error => { %>
      <li><%= error.msg %></li>
    <% }) %>
  </ul>
  <br />
<% } %>

<div class="manager-container">
  <!-- Section utilisateur -->
  <section class="manager-container">
    <h2>Welcome <%= locals.accountData ? locals.accountData.account_firstname : "Guest" %></h2>
    <% if (locals.accountData) { %>
      <p>You're logged in</p>
      <a href="/account/update/<%= locals.accountData.account_id %>" title="Click to update">Update Account Information</a>
    <% } else { %>
      <p>You are browsing as a guest.</p>
    <% } %>
  </section>

  <!-- Section gestion inventaire -->
  <section class="manager-container">
    <h3>Inventory Management</h3>
    <div>
      <a href="/inv">Manage Inventory</a>
    </div>
  </section>

  <!-- Section gestion utilisateurs (visible seulement si admin connecté) -->
  <% if (locals.accountData && locals.accountData.account_type === 'Admin') { %>
    <section class="manager-container">
      <h3>Users Management</h3>
      <div>
        <a href="/users">Users List</a>
      </div>
    </section>
  <% } %>
</div>
