<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title || "Login" %></title>
  <link rel="stylesheet" href="/css/styles.css" />
</head>
<body>
  <main class="login-page">
    <h1><%= title || "Login to Your Account" %></h1>

    <!-- ✅ Zone de messages flash -->
    <% if (messages && messages.length > 0) { %>
      <div class="flash-messages">
        <% messages.forEach(msg => { %>
          <p class="flash <%= msg.type || 'info' %>"><%= msg.text %></p>
        <% }) %>
      </div>
    <% } %>

    <!-- ✅ Zone d’erreurs -->
    <% if (errors && errors.length > 0) { %>
      <ul class="error-list">
        <% errors.forEach(error => { %>
          <li><%= error.msg %></li>
        <% }) %>
      </ul>
    <% } %>

    <div class="form-container">
      <form id="loginForm" action="/account/login" method="post">
        <div class="form-group">
          <label for="email">Email:</label>
          <input
            type="email"
            id="email"
            name="account_email"
            required
            placeholder="Enter your email address"
            value="<%= login_email || '' %>"
          />
        </div>

        <div class="form-group">
          <label for="password">Password:</label>
          <input
            type="password"
            id="password"
            name="account_password"
            required
            placeholder="Enter your password"
            pattern="^(?=.*\\d)(?=.*[a-z])(?=.*[A-Z])(?=.*[^a-zA-Z0-9])(?!.*\\s).{12,}$"
          />
          <small class="password-hint">
            Must contain at least 12 characters, including an uppercase letter, 
            a number, and a special character.
          </small>
        </div>

        <button id="pwd-visibility" type="button">Show / Hide Password</button>
        <button type="submit" class="btn-account">Login</button>
      </form>

      <p id="no-account">
        Don't have an account?
        <a href="/account/register" id="registerLink">Sign up</a>
      </p>
    </div>
  </main>

  <script src="/js/script.js"></script>
</body>
</html>
